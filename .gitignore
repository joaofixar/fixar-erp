sistema-legado/

# Credenciais locais, inclusive leitura da produção
.env
.env.*
!.env.example

# Cópia que sobe na máquina. Não leva segredo, cache, uso nem outro cliente.
/base

# Cache, arquivo de uso e o backup que carrega senha, se aparecerem na raiz
smarty/templates_c/
dados_usuarios/
scripts/backup/
static/css/temas/tema_*_cache.css
bin/__pycache__/

# Override local de porta. O compose commitado publica 8080.
docker-compose.override.yml
# Porta do percurso com volume vazio. Não muda a porta commitada.
docker-compose.nascimento.yml

