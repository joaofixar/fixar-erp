#!/usr/bin/env bash
# Olha a publicação e, quando pedido, traz o merge para uma branch nova.
# Não troca o checkout e não fala com o banco.
# Sem ação, mostra o passo a passo.
set -euo pipefail

passos() {
  cat <<'EOF'
Publicação do Hardness

1. Ver se chegou algo. Não muda o src.

   bash bin/publicacao olhar

   Lista vazia e volta ao prompt: está na ponta.
   Linhas com SHA e assunto: a publicação andou.

2. Trazer a ponta. Onde os dois lados mudaram o mesmo arquivo, fica a publicação.
   Em seguida a branch recebe de novo os ajustes do PHP 8.

   bash bin/publicacao trazer --sobrescrever

   O comando imprime publicacao/<sha>. O src da base ainda é o antigo.
   Se o trecho de bibliotecas/funcoesGerais.php não encaixa, o comando para.

3. Passar a servir esse código.

   git merge --ff-only publicacao/<sha>

Segredo, personalização e arquivo de outro cliente ficam de fora.
Rotina nova só entra no banco na próxima subida do contêiner.
EOF
}

uso() {
  echo "Uso: publicacao olhar|trazer [--raiz DIR] [--publicacao DIR] [--ponto SHA] [--sobrescrever]" >&2
  echo >&2
  passos >&2
  exit 2
}

if [ $# -lt 1 ]; then
  passos
  exit 0
fi
acao="$1"
shift

raiz=""
publicacao=""
ponto=""
sobrescrever=0
while [ $# -gt 0 ]; do
  case "$1" in
    --raiz)
      raiz="${2:-}"
      shift 2
      ;;
    --publicacao)
      publicacao="${2:-}"
      shift 2
      ;;
    --ponto)
      ponto="${2:-}"
      shift 2
      ;;
    --sobrescrever)
      sobrescrever=1
      shift
      ;;
    *)
      uso
      ;;
  esac
done

if [ -z "$raiz" ]; then
  raiz="$(cd "$(dirname "$0")/.." && pwd)"
fi
if [ -z "$publicacao" ]; then
  publicacao="//wsl.localhost/Ubuntu-20.04/root/sistema_hardness/hardness3"
fi

export GIT_TERMINAL_PROMPT=0
export GIT_PAGER=cat

aviso() {
  printf '%s\n' "$*" >&2
}

nossa_tmp=""
cmp_tmp=""
lista_tmp=""
indice_erp_tmp=""
ponto_tmp=""
mudancas_tmp=""
limpar_temporarios() {
  rm -rf "$nossa_tmp" "$cmp_tmp"
  rm -f "$lista_tmp" "$indice_erp_tmp" "$ponto_tmp" "$mudancas_tmp"
}
trap limpar_temporarios EXIT

caminho_excluido() {
  local rel="$1"
  local baixo
  case "$rel" in
    outros/personalizacoes|outros/personalizacoes/*) return 0 ;;
    bibliotecas/confUsuario.php|bibliotecas/confUsuario.original) return 0 ;;
    ide/sysConfig.php) return 0 ;;
    scripts/queueMDFE/conf.php|scripts/queueMDFE/conf.php.original) return 0 ;;
    scripts/queueNF/conf.original.php) return 0 ;;
    dados_usuarios|dados_usuarios/*) return 0 ;;
    smarty/templates_c|smarty/templates_c/*) return 0 ;;
    smarty/cache|smarty/cache/*) return 0 ;;
    bibliotecas/tcpdf/cache|bibliotecas/tcpdf/cache/*) return 0 ;;
    hardness/phpqrcode/cache|hardness/phpqrcode/cache/*) return 0 ;;
    scripts/backup|scripts/backup/*) return 0 ;;
    static/css/temas/tema_*_cache.css) return 0 ;;
    *.p12|*.keystore) return 0 ;;
    configuracoes/painel-comercial-inecel-root-63.json) return 0 ;;
    bibliotecas/layouts_remessa/manual/Manual\ Remessa\ HSBC.pdf) return 0 ;;
    bibliotecas/layouts_remessa/manual/cresol/Manual\ Especificacoes\ Tecnicas\ Cresol.pdf) return 0 ;;
    bibliotecas/validadorNFe/Manual_de_Orientacao_Contribuinte_v_6.00.pdf) return 0 ;;
    outros/etiquetas/manuais/impressoraArgox/sManual_Portuguese.pdf) return 0 ;;
    outros/etiquetas/manuais/impressoraEPL/zsu-1191060.exe) return 0 ;;
    outros/leitorBiometrico/desenvolvimento/nitgen\ enbsp.rar) return 0 ;;
    scripts/TabelaTIPI/TIPI\ -\ I\ -\ SE__O\ VI.htm) return 0 ;;
    smarty/B2B/images/img-hardness.png) return 0 ;;
    static/download/ChromeStandaloneSetup.exe) return 0 ;;
    static/download/jre-7u51-windows-i586.exe) return 0 ;;
    static/download/leitorbio.zip) return 0 ;;
    static/download/smt-print-1.0.0.exe) return 0 ;;
    static/download/smt-print-1.0.0.pdf) return 0 ;;
    static/js/monaco-editor/0.25.2/dev/vs/editor/editor.main.js) return 0 ;;
    static/js/monaco-editor/0.25.2/dev/vs/editor/editor.main.js.map) return 0 ;;
    static/js/monaco-editor/0.25.2/dev/vs/language/typescript/tsWorker.js) return 0 ;;
    static/js/monaco-editor/0.25.2/esm/vs/language/typescript/lib/typescriptServices.js) return 0 ;;
    static/js/monaco-editor/0.25.2/min-maps/vs/editor/editor.main.js.map) return 0 ;;
    outros/apps/apps.key) return 0 ;;
    bibliotecas/tcpdf/tcpdf.crt) return 0 ;;
    mobile/cert/my-release-key.keystore) return 0 ;;
    .idea|.idea/*) return 0 ;;
    outros/java/.metadata|outros/java/.metadata/*) return 0 ;;
    outros/mobileAndroid/workspace/.metadata|outros/mobileAndroid/workspace/.metadata/*) return 0 ;;
    prog/sistema/progs/db.eurosul.serialized) return 0 ;;
    prog/sistema/progs/db.sigmacar.serialized) return 0 ;;
    scripts/notifications/notificacoes.sh) return 0 ;;
    scripts/notifications/notificacoesHora.sh) return 0 ;;
    site/conf.php) return 0 ;;
    rest_api/config/app.local.php) return 0 ;;
    Thumbs.db) return 0 ;;
    ide|ide/*) return 0 ;;
    apps|apps/*) return 0 ;;
    framework|framework/*) return 0 ;;
    bibliotecas/composer/vendor|bibliotecas/composer/vendor/*) return 0 ;;
    bibliotecas/webservices/meli/README.md) return 0 ;;
    bibliotecas/webservices/meli/CONEXAO_MELI_COMPLETA.md) return 0 ;;
    bibliotecas/webservices/meli/conexaoMeli.php) return 0 ;;
    .vscode|.vscode/*) return 0 ;;
    rest_api/storage/cache|rest_api/storage/cache/*) return 0 ;;
  esac
  baixo="$(printf '%s' "$rel" | tr '[:upper:]' '[:lower:]')"
  case "$baixo" in
    *ceigon*|*guimepa*|*eurosul*|*boticario*|*boticário*|*derosso*|*emprefix*|*nacomaq*|*panceri*|*vedapar*)
      return 0
      ;;
  esac
  return 1
}

arvore_nossa() {
  local destino="$1"
  local caminho rel copiados
  git init -q -b master "$destino"
  git -C "$destino" config user.email teste@fixar.local
  git -C "$destino" config user.name Teste
  copiados=0
  aviso "Copiando o Hardness versionado."
  while IFS= read -r -d '' caminho; do
    rel="${caminho#src/hardness3/}"
    if caminho_excluido "$rel"; then
      continue
    fi
    if [ ! -f "$raiz/$caminho" ]; then
      continue
    fi
    mkdir -p "$destino/$(dirname -- "$rel")"
    cp -- "$raiz/$caminho" "$destino/$rel"
    copiados=$((copiados + 1))
    if [ $((copiados % 1000)) -eq 0 ]; then
      aviso "Copiados $copiados arquivos."
    fi
  done < <(git -C "$raiz" ls-files -z -- src/hardness3)
  aviso "Árvore copiada, $copiados arquivos. Registrando no git."
  git -C "$destino" add -A
  git -C "$destino" commit -q --allow-empty -m "nossa"
}

distancia() {
  local commit="$1"
  local our_tree="$2"
  local repo="$3"
  local n=0 status caminho
  while IFS=$'\t' read -r status caminho; do
    [ -n "${status:-}" ] || continue
    case "$status" in
      A*) continue ;;
    esac
    if caminho_excluido "$caminho"; then
      continue
    fi
    n=$((n + 1))
  done < <(git -C "$repo" diff-tree -r --no-renames --name-status "${commit}^{tree}" "$our_tree")
  printf '%s\n' "$n"
}

candidatos() {
  local our_tree commit dist assunto menor total vistos
  buscar
  nossa_tmp="$(mktemp -d)"
  cmp_tmp="$(mktemp -d)"
  lista_tmp="$(mktemp)"
  arvore_nossa "$nossa_tmp"
  aviso "Preparando a comparação com a publicação."
  git init -q -b master "$cmp_tmp"
  git -C "$cmp_tmp" fetch -q --no-tags "$publicacao" 'refs/remotes/origin/master:refs/heads/deles'
  git -C "$cmp_tmp" fetch -q --no-tags "$nossa_tmp" 'HEAD:refs/heads/nossa'
  our_tree="$(git -C "$cmp_tmp" rev-parse 'nossa^{tree}')"
  total="$(git -C "$cmp_tmp" rev-list --count refs/heads/deles)"
  vistos=0
  aviso "Comparando com $total commits. Isso demora e cada linha abaixo é progresso."
  while read -r commit; do
    dist="$(distancia "$commit" "$our_tree" "$cmp_tmp")"
    assunto="$(git -C "$cmp_tmp" log -1 --format='%s' "$commit")"
    printf '%s\t%s\t%s\n' "$dist" "$commit" "$assunto"
    vistos=$((vistos + 1))
    if [ $((vistos % 25)) -eq 0 ]; then
      aviso "Comparados $vistos de $total."
    fi
  done < <(git -C "$cmp_tmp" rev-list refs/heads/deles) >"$lista_tmp"
  if [ ! -s "$lista_tmp" ]; then
    echo "A publicação não tem commit em master." >&2
    exit 1
  fi
  menor="$(sort -t "$(printf '\t')" -k1,1n -k2,2 "$lista_tmp" | head -n 1 | cut -f1)"
  while IFS="$(printf '\t')" read -r dist commit assunto; do
    if [ "$dist" != "$menor" ]; then
      break
    fi
    printf 'candidato %s %s %s\n' "$commit" "$dist" "$assunto"
  done < <(sort -t "$(printf '\t')" -k1,1n -k2,2 "$lista_tmp")
}

gravar_ponto() {
  local completo
  if ! completo="$(git -C "$publicacao" rev-parse --verify "${ponto}^{commit}" 2>/dev/null)"; then
    echo "O SHA informado não está na publicação." >&2
    exit 1
  fi
  mkdir -p "$raiz/bin"
  printf '%s\n' "$completo" >"$raiz/bin/ponto"
  aviso "Ponto gravado: $completo"
}

buscar() {
  aviso "Buscando a publicação."
  if ! git -C "$publicacao" fetch origin '+refs/heads/master:refs/remotes/origin/master' >/dev/null 2>&1; then
    echo "Não foi possível buscar a publicação." >&2
    exit 1
  fi
  aviso "Busca concluída."
}

listar() {
  local gravado
  gravado="$(head -n 1 "$raiz/bin/ponto" | tr -d '[:space:]')"
  buscar
  aviso "Listando os commits depois do ponto."
  git --no-pager -C "$publicacao" log --reverse --format='%H %s' "${gravado}..origin/master"
}

olhar() {
  if [ -n "$ponto" ]; then
    gravar_ponto
    return 0
  fi
  if [ -f "$raiz/bin/ponto" ]; then
    listar
    return 0
  fi
  candidatos
}

diretorio_objetos() {
  local dir
  dir="$(git -C "$1" rev-parse --path-format=absolute --git-common-dir)/objects"
  if command -v cygpath >/dev/null 2>&1; then
    cygpath -w "$dir"
  else
    printf '%s\n' "$dir"
  fi
}

ligar_objetos() {
  local destino="$1"
  mkdir -p "$destino/.git/objects/info"
  {
    diretorio_objetos "$raiz"
    diretorio_objetos "$publicacao"
  } >"$destino/.git/objects/info/alternates"
}

# A exclusão e a cópia olham só o diff entre o ponto e a ponta.
# Arquivo que ninguém mexeu permanece o da Fixar.
listar_mudancas() {
  local base_tree="$1"
  local their_tree="$2"
  local total
  mudancas_tmp="$(mktemp)"
  git -C "$publicacao" diff-tree -z -r --no-renames --name-only "$base_tree" "$their_tree" \
    | tr '\0' '\n' >"$mudancas_tmp"
  total="$(grep -c . "$mudancas_tmp" || true)"
  if [ "$total" -eq 1 ]; then
    aviso "A publicação mexeu em 1 caminho."
  else
    aviso "A publicação mexeu em $total caminhos."
  fi
}

restaurar_exclusoes() {
  local indice="$1"
  local our_tree="$2"
  local caminho linha modo blob vistos
  vistos=0
  while IFS= read -r caminho; do
    [ -n "$caminho" ] || continue
    if ! caminho_excluido "$caminho"; then
      continue
    fi
    vistos=$((vistos + 1))
    GIT_INDEX_FILE="$indice" git -C "$cmp_tmp" update-index --force-remove -- "$caminho" || true
    if git -C "$cmp_tmp" cat-file -e "${our_tree}:${caminho}" 2>/dev/null; then
      linha="$(git -C "$cmp_tmp" ls-tree "$our_tree" -- "$caminho")"
      modo="${linha%% *}"
      blob="$(git -C "$cmp_tmp" rev-parse "${our_tree}:${caminho}")"
      GIT_INDEX_FILE="$indice" git -C "$cmp_tmp" update-index --add --cacheinfo "$modo,$blob,$caminho"
    fi
  done <"$mudancas_tmp"
  if [ "$vistos" -eq 1 ]; then
    aviso "Personalização, segredo e arquivo de outro cliente ficam de fora. 1 caminho."
  elif [ "$vistos" -gt 1 ]; then
    aviso "Personalização, segredo e arquivo de outro cliente ficam de fora. $vistos caminhos."
  fi
}

importar_arvore() {
  local our_tree="$1"
  local merged="$2"
  local faltando
  faltando="$(mktemp)"
  {
    printf '%s\n' "$merged"
    git -C "$cmp_tmp" -c core.abbrev=40 diff-tree --full-index -t -r --raw "$our_tree" "$merged" \
      | awk '{ if ($4 !~ /^0+$/) print $4 }'
  } | sort -u \
    | git -C "$raiz" cat-file --batch-check='%(objectname) %(objecttype)' \
    | awk '$2 == "missing" { print $1 }' >"$faltando"
  if [ -s "$faltando" ]; then
    aviso "Copiando o que a publicação mudou."
    git -C "$cmp_tmp" pack-objects --stdout -q <"$faltando" | git -C "$raiz" unpack-objects -q
  fi
  rm -f "$faltando"
}

aplicar_adaptacoes() {
  local indice="$1"
  local trabalho mudados diretorio adaptador python caminho blob modo
  trabalho="$cmp_tmp/arvore"
  mudados="$cmp_tmp/mudados"
  mkdir -p "$trabalho"
  GIT_INDEX_FILE="$indice" git -C "$cmp_tmp" checkout-index -a --prefix="arvore/"
  diretorio="$trabalho"
  adaptador="$(cd "$(dirname "$0")" && pwd)/adaptar-hardness.py"
  if command -v cygpath >/dev/null 2>&1; then
    diretorio="$(cygpath -w "$trabalho")"
    adaptador="$(cygpath -w "$adaptador")"
  fi
  if command -v python >/dev/null 2>&1; then
    python="python"
  else
    python="python3"
  fi
  aviso "Reaplicando os ajustes do PHP 8."
  if ! "$python" "$adaptador" "$diretorio" >"$mudados"; then
    echo "O trazer parou sem avançar o ponto." >&2
    exit 1
  fi
  while IFS= read -r caminho; do
    caminho="${caminho%$'\r'}"
    [ -n "$caminho" ] || continue
    blob="$(git -C "$cmp_tmp" hash-object -w -- "$trabalho/$caminho")"
    modo="$(GIT_INDEX_FILE="$indice" git -C "$cmp_tmp" ls-files -s -- "$caminho" | awk '{ print $1; exit }')"
    GIT_INDEX_FILE="$indice" git -C "$cmp_tmp" update-index --cacheinfo "${modo:-100644},$blob,$caminho"
  done <"$mudados"
}

ficar_com_a_publicacao() {
  local indice="$1"
  local caminho modo blob n
  n=0
  aviso "Onde os dois mudaram, fica a publicação."
  while IFS= read -r caminho; do
    [ -n "$caminho" ] || continue
    if blob="$(GIT_INDEX_FILE="$indice" git -C "$cmp_tmp" rev-parse -q --verify ":3:${caminho}")"; then
      modo="$(GIT_INDEX_FILE="$indice" git -C "$cmp_tmp" ls-files -u -- "$caminho" | awk '$3 == 3 { print $1; exit }')"
      GIT_INDEX_FILE="$indice" git -C "$cmp_tmp" update-index --add --cacheinfo "${modo:-100644},$blob,$caminho"
    else
      GIT_INDEX_FILE="$indice" git -C "$cmp_tmp" update-index --force-remove -- "$caminho" || true
    fi
    n=$((n + 1))
    if [ $((n % 50)) -eq 0 ]; then
      aviso "Publicação aplicada em $n arquivos em conflito."
    fi
  done < <(GIT_INDEX_FILE="$indice" git -C "$cmp_tmp" ls-files -u --format='%(path)' | sort -u)
  aviso "Publicação aplicada em $n arquivos em conflito."
}

trazer() {
  local base_sha tip indice merged parent novo caminho houve blob novo_tree
  local base_tree their_tree our_tree
  if [ ! -f "$raiz/bin/ponto" ]; then
    echo "Não há ponto gravado." >&2
    exit 1
  fi
  base_sha="$(head -n 1 "$raiz/bin/ponto" | tr -d '[:space:]')"
  aviso "Ponto de parada: $base_sha"
  buscar
  tip="$(git -C "$publicacao" rev-parse refs/remotes/origin/master)"
  aviso "Ponta da publicação: $tip"
  if git -C "$raiz" show-ref --verify --quiet "refs/heads/publicacao/$tip"; then
    echo "A branch publicacao/$tip já existe." >&2
    exit 1
  fi
  if ! our_tree="$(git -C "$raiz" rev-parse --verify 'HEAD:src/hardness3' 2>/dev/null)"; then
    echo "O src/hardness3 não está no commit atual." >&2
    exit 1
  fi
  if ! base_tree="$(git -C "$publicacao" rev-parse --verify "${base_sha}^{tree}" 2>/dev/null)"; then
    echo "O ponto gravado não está na publicação." >&2
    exit 1
  fi
  their_tree="$(git -C "$publicacao" rev-parse "${tip}^{tree}")"
  listar_mudancas "$base_tree" "$their_tree"

  cmp_tmp="$(mktemp -d)"
  git init -q -b master "$cmp_tmp"
  ligar_objetos "$cmp_tmp"

  indice="$cmp_tmp/indice"
  aviso "Juntando o ponto, o Hardness da Fixar e a ponta."
  # Inclusão e exclusão em que só um lado mexeu entram, como no pull.
  GIT_INDEX_FILE="$indice" git -C "$cmp_tmp" read-tree -m --aggressive "$base_tree" "$our_tree" "$their_tree"
  restaurar_exclusoes "$indice" "$our_tree"
  if [ "$sobrescrever" -eq 1 ]; then
    ficar_com_a_publicacao "$indice"
  fi

  houve=0
  while IFS= read -r caminho; do
    [ -n "$caminho" ] || continue
    printf 'conflito %s\n' "$caminho"
    houve=1
  done < <(GIT_INDEX_FILE="$indice" git -C "$cmp_tmp" ls-files -u --format='%(path)' | sort -u)
  if [ "$houve" -eq 1 ]; then
    echo "O trazer parou sem avançar o ponto." >&2
    exit 1
  fi

  aplicar_adaptacoes "$indice"

  aviso "Gravando a branch. O checkout atual não muda."
  merged="$(GIT_INDEX_FILE="$indice" git -C "$cmp_tmp" write-tree)"
  importar_arvore "$our_tree" "$merged"

  indice_erp_tmp="$(mktemp)"
  ponto_tmp="$(mktemp)"
  printf '%s\n' "$tip" >"$ponto_tmp"
  GIT_INDEX_FILE="$indice_erp_tmp" git -C "$raiz" read-tree HEAD
  GIT_INDEX_FILE="$indice_erp_tmp" git -C "$raiz" rm -r --cached -q --ignore-unmatch -- src/hardness3
  GIT_INDEX_FILE="$indice_erp_tmp" git -C "$raiz" read-tree --prefix=src/hardness3/ "$merged"
  blob="$(git -C "$raiz" hash-object -w -- "$ponto_tmp")"
  GIT_INDEX_FILE="$indice_erp_tmp" git -C "$raiz" update-index --add --cacheinfo "100644,$blob,bin/ponto"
  novo_tree="$(GIT_INDEX_FILE="$indice_erp_tmp" git -C "$raiz" write-tree)"
  parent="$(git -C "$raiz" rev-parse HEAD)"
  novo="$(git -C "$raiz" commit-tree "$novo_tree" -p "$parent" -m "feat(publicacao): traz a publicação até $tip")"
  git -C "$raiz" branch "publicacao/$tip" "$novo"
  printf '%s\n' "$tip" >"$raiz/bin/ponto"
  printf 'publicacao/%s\n' "$tip"
}

case "$acao" in
  olhar) olhar ;;
  trazer) trazer ;;
  *) uso ;;
esac
