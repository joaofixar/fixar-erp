FROM php:8.3-apache

# Mesmas extensões da base local, mais as que o Composer exige (nota, planilha, PDF).
# Esta imagem não leva o bloqueio de saída.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        $PHPIZE_DEPS \
        unzip \
        libzip-dev \
        libpng-dev \
        libjpeg62-turbo-dev \
        libfreetype6-dev \
        libicu-dev \
        libxml2-dev \
    && pecl install apcu \
    && docker-php-ext-enable apcu \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install mysqli gd zip soap intl \
    && a2enmod rewrite \
    && apt-get purge -y --auto-remove $PHPIZE_DEPS \
    && rm -rf /var/lib/apt/lists/*

COPY docker/php/apache.prod.conf /etc/apache2/sites-available/000-default.conf
COPY docker/php/mpm-prefork.prod.conf /etc/apache2/mods-available/mpm_prefork.conf
COPY docker/php/servername.conf /etc/apache2/conf-enabled/servername.conf
COPY docker/php/compatibilidade.prod.php /usr/local/etc/php/compatibilidade.php
COPY docker/php/php.prod.ini /usr/local/etc/php/conf.d/fixar.ini
COPY docker/php/gravar-conf.php /usr/local/bin/gravar-conf.php
COPY docker/php/entrada.sh /usr/local/bin/entrada
COPY src /var/www/html

# O vendor não entra no git. A imagem instala o que está no composer.lock.
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
RUN composer install --no-dev --no-interaction --no-progress \
        --working-dir=/var/www/html/hardness3/bibliotecas/composer \
    && rm /usr/bin/composer \
    && chmod +x /usr/local/bin/entrada \
    && mkdir -p /var/lib/php/sessions \
        /var/www/html/hardness3/dados_usuarios \
        /var/www/html/hardness3/smarty/templates_c \
        /var/www/html/hardness3/smarty/cache

ENTRYPOINT ["/usr/local/bin/entrada"]
CMD ["apache2-foreground"]
