FROM php:8.3-apache

# Mesmas extensões da base local. Esta imagem não leva o bloqueio de saída.
RUN apt-get update \
    && apt-get install -y --no-install-recommends $PHPIZE_DEPS \
    && pecl install apcu \
    && docker-php-ext-enable apcu \
    && docker-php-ext-install mysqli \
    && a2enmod rewrite \
    && apt-get purge -y --auto-remove $PHPIZE_DEPS \
    && rm -rf /var/lib/apt/lists/*

COPY apache.prod.conf /etc/apache2/sites-available/000-default.conf
COPY compatibilidade.prod.php /usr/local/etc/php/compatibilidade.php
COPY php.prod.ini /usr/local/etc/php/conf.d/fixar.ini
