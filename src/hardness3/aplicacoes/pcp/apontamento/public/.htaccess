Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{THE_REQUEST} \s/+hardness3/aplicacoes/pcp/apontamento/public(?:/[^\s?]*)? [NC]
    RewriteRule ^(?:index\.php)?$ /apontamento/ [R=302,L,NE]
    RewriteRule ^(.*)$ /apontamento/$1 [R=302,L,NE]
</IfModule>
