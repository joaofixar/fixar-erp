    {
      "id": "dataInicio",
      "titulo": "Data inicial da projeção",
      "tipo": "data",
      "padrao": "hoje",
      "obrigatorio": true
    },
    {
      "id": "diasProjecao",
      "titulo": "Dias de projeção",
      "tipo": "numero",
      "padrao": 45,
      "inteiro": true,
      "minimo": 7,
      "maximo": 366,
      "obrigatorio": true
    }
  ],
  "sqlBase": [
    "SELECT T002_Id AS id, COALESCE(NULLIF(TRIM(D027_Portador), ''), 'Sem portador') AS portador,",
    "IFNULL(D027_Flag_Boleto, 'N') AS boleto, T002_Data_Vencimento AS data, T002_Valor_Saldo AS valor",
    "FROM T002 LEFT JOIN D027 ON D027_Id = T002_D027_Id",
    "WHERE (T002_C004_Id IN (",
    "  CASE WHEN :abrangenciaEmpresa = 'atual' THEN :empresa WHEN :abrangenciaEmpresa IN ('todas', '1') THEN 1 ELSE NULL END,",
    "  CASE WHEN :abrangenciaEmpresa IN ('todas', '2') THEN 2 ELSE NULL END,",
    "  CASE WHEN :abrangenciaEmpresa IN ('todas', '4') THEN 4 ELSE NULL END,",
    "  CASE WHEN :abrangenciaEmpresa IN ('todas', '5') THEN 5 ELSE NULL END",
    ") AND (:abrangenciaEmpresa <> 'atual' OR T002_C004_Id = :empresa))",
    "AND IFNULL(T002_Flag_Cancelada, 'N') <> 'S'",
    "AND (T002_Data_Recebimento IS NULL OR T002_Data_Recebimento = '0000-00-00')",
    "AND (T002_T002_Id_Agrupado IS NULL OR T002_T002_Id_Agrupado <= 0)",
    "AND IFNULL(T002_Flag_Status, '1') <> '6'",
    "AND T002_Valor_Saldo > 0 AND T002_Data_Vencimento >= :dataInicio"
  ],
