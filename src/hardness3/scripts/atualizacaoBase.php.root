$dbNota = array('e091', 'e099', 'e126', 'e136', 'e207', 'e282', 'e308', 'e310', 'e312', 'e362', 'e363', 'e364', 'e365', 'e366');
foreach ($dbNota as $db) {
    $check = mysql_query("SHOW TABLES FROM {$db} LIKE 'C004'");
    if(mysql_num_rows($check) == 1){
        echo "ATUALIZANDO DB: " . $db . "\n";
        if(mysql_select_db($db, $link)){
            mysql_set_charset('utf8');
