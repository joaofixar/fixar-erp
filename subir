#!/usr/bin/env bash
# Sobe a base local: grava a conexão e o cache, abre o contêiner e semeia o banco.
set -euo pipefail

cd "$(dirname "$0")"

case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*)
    export DOCKER_HOST="${DOCKER_HOST:-npipe:////./pipe/kiri}"
    ;;
esac

if python -c "import sys" >/dev/null 2>&1; then
  py=python
elif python3 -c "import sys" >/dev/null 2>&1; then
  py=python3
else
  echo "Falta o Python para preparar a cópia." >&2
  exit 1
fi
"$py" bin/preparar-base.py
if ! docker image inspect fixar-erp-web >/dev/null 2>&1; then
  docker build -t fixar-erp-web ./docker/php
fi
docker compose up -d --no-build --wait
"$py" bin/carregar-estrutura.py
echo "Base no ar: http://web.fixar-erp.kiri.localhost/login"
