#!/usr/bin/env bash
# Sobe a base local: grava a conexão e o cache, e abre o contêiner.
set -euo pipefail

cd "$(dirname "$0")"

case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*)
    export DOCKER_HOST="${DOCKER_HOST:-npipe:////./pipe/kiri}"
    ;;
esac

if python -c "import sys" >/dev/null 2>&1; then
  py=python
elif python3 -c "import sys" >/dev/null 2>&1; then
  py=python3
else
  echo "Falta o Python para preparar a cópia." >&2
  exit 1
fi
"$py" bin/preparar-base.py
# Sempre constrói: o cache de camadas deixa isso rápido, e uma mudança no Dockerfile
# chega a quem já tinha a imagem. --load põe a imagem no engine do Kiri.
docker build --load -q -t fixar-erp-web ./docker/php >/dev/null
# A fotografia entra só com o volume vazio. Um volume já preenchido permanece.
docker compose up -d --no-build --wait
echo "Base no ar: http://web.fixar-erp.kiri.localhost/login"
